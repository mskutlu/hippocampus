#!/usr/bin/env bash
# Hippocampus UserPromptSubmit hook.
#
# Stdin: JSON with at least {"prompt": "<user message>"}.
# Stdout: JSON with hookSpecificOutput.additionalContext containing the LIVE
#         working ledger + top long-term memories.
#
# Side effect: logs the ask to the working-memory ledger so the AI does
# not have to call log_progress(kind="ask", ...) manually.
#
# Never blocks the turn — any internal error degrades to "{}".
#
# V1.5+ behaviour: re-inject the working block on every user message as
# additionalContext. This is the universal compaction-safety mechanism:
# the rules file is loaded once at session start, so even when the AI
# context is compacted, the very next user message refreshes the
# WORKING block via this hook.

set -uo pipefail

CLIENT="${1:-devin}"
HIPPO_BIN="__HIPPO_BIN__"

detect_hippo_context() {
    if [[ -z "${HIPPOCAMPUS_TTY:-}" ]]; then
        local tty_name
        tty_name="$(tty 2>/dev/null || true)"
        if [[ "$tty_name" == "not a tty" ]]; then
            tty_name=""
        fi
        if [[ -z "$tty_name" ]]; then
            tty_name="$(ps -o tty= -p "$PPID" 2>/dev/null | tr -d ' ' || true)"
            if [[ "$tty_name" == "?" || "$tty_name" == "??" ]]; then
                tty_name=""
            fi
        fi
        export HIPPOCAMPUS_TTY="$tty_name"
    fi
    export HIPPOCAMPUS_CWD="${HIPPOCAMPUS_CWD:-${PWD:-}}"
}

detect_hippo_context

bind_claude_session() {
    [[ "$CLIENT" == "claude-code" ]] || return 0
    local sid
    sid=$(python3 -c '
import json, sys
try:
    print(json.loads(sys.stdin.read() or "{}").get("session_id") or "")
except Exception:
    pass
' <<< "${INPUT_JSON:-}" 2>/dev/null || true)
    sid="${sid:-${CLAUDE_CODE_SESSION_ID:-}}"
    [[ -n "$sid" ]] || return 0
    # Same claude session across cwd changes.
    export HIPPOCAMPUS_SESSION_KEY="cc-${sid}"
    export HIPPOCAMPUS_CLAUDE_PID="$PPID"
}

INPUT_JSON="$(cat || true)"
bind_claude_session

PROMPT=""
FULL_PROMPT_FILE=""
if [[ -n "$INPUT_JSON" ]]; then
    # Capped 500-char version goes into the ledger as the ask.
    PROMPT=$(python3 -c '
import json, sys
try:
    data = json.loads(sys.stdin.read() or "{}")
except Exception:
    data = {}
prompt = (data.get("prompt") or "").strip()
if prompt:
    print(prompt[:500])
' <<< "$INPUT_JSON" 2>/dev/null || true)

    # Full prompt (uncapped) goes to autoremember so multi-paragraph
    # "from now on, always do X" rules don't get truncated.
    FULL_PROMPT_FILE=$(mktemp -t hippo-prompt.XXXXXX)
    python3 -c '
import json, sys
try:
    data = json.loads(sys.stdin.read() or "{}")
except Exception:
    data = {}
prompt = (data.get("prompt") or "").strip()
sys.stdout.write(prompt)
' <<< "$INPUT_JSON" > "$FULL_PROMPT_FILE" 2>/dev/null || true
fi

# Write side effects (transcript -> ask -> autoremember) run in one detached
# background subshell, in order, so their startup + SQLite lock waits don't
# eat the hook's timeout. Only `context` below produces output.
# ponytail: the ask may land after the snapshot renders, so it shows up one turn late.
(
    # Store the full raw prompt in transcript history before the capped ledger ask.
    PROMPT_LOGGED=""
    if [[ -n "$FULL_PROMPT_FILE" && -s "$FULL_PROMPT_FILE" && -x "$HIPPO_BIN" ]]; then
        if HIPPOCAMPUS_CLIENT="$CLIENT" "$HIPPO_BIN" transcript log user --client "$CLIENT" --source-event UserPromptSubmit --stdin < "$FULL_PROMPT_FILE" >/dev/null 2>&1; then
            PROMPT_LOGGED="1"
        fi
    fi

    if [[ -n "$PROMPT" && -x "$HIPPO_BIN" ]]; then
        HIPPOCAMPUS_CLIENT="$CLIENT" HIPPOCAMPUS_TRANSCRIPT_PROMPT_LOGGED="$PROMPT_LOGGED" "$HIPPO_BIN" progress log ask "$PROMPT" --client "$CLIENT" >/dev/null 2>&1 || true
    fi

    # V9 G5 — auto-remember on "remember / always / never / add to rules / …" triggers.
    if [[ -n "$FULL_PROMPT_FILE" && -s "$FULL_PROMPT_FILE" && -x "$HIPPO_BIN" ]]; then
        HIPPOCAMPUS_CLIENT="$CLIENT" "$HIPPO_BIN" autoremember --client "$CLIENT" --stdin --quiet < "$FULL_PROMPT_FILE" >/dev/null 2>&1 || true
    fi
    [[ -n "$FULL_PROMPT_FILE" ]] && rm -f "$FULL_PROMPT_FILE"
) </dev/null >/dev/null 2>&1 &
disown 2>/dev/null || true

# Render the live snapshot — working ledger + top fragments matching the prompt.
CONTEXT=""
if [[ -x "$HIPPO_BIN" ]]; then
    if [[ -n "$PROMPT" ]]; then
        CONTEXT=$(HIPPOCAMPUS_CLIENT="$CLIENT" "$HIPPO_BIN" context --client "$CLIENT" --query "$PROMPT" --event UserPromptSubmit 2>/dev/null || true)
    else
        CONTEXT=$(HIPPOCAMPUS_CLIENT="$CLIENT" "$HIPPO_BIN" context --client "$CLIENT" --event UserPromptSubmit 2>/dev/null || true)
    fi
fi

if [[ -z "$CONTEXT" ]]; then
    echo "{}"
    exit 0
fi

python3 -c '
import json, sys
ctx = sys.stdin.read()
print(json.dumps({
    "hookSpecificOutput": {
        "hookEventName": "UserPromptSubmit",
        "additionalContext": ctx,
    },
    "additionalContext": ctx,
}))
' <<< "$CONTEXT"
