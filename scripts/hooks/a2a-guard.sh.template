#!/usr/bin/env bash
# Hippocampus A2A guard for Claude Code: PreToolUse (tool lockdown during an
# A2A peer turn) and Stop (ends the peer turn).
#
# Usage: a2a-guard.sh <pretooluse|stop> <client>
# Stdin: the Claude Code hook JSON. A denied PreToolUse exits 2 with the reason
#        on stderr (blocks before permission rules, also under bypassPermissions).
#
# Hot path on every tool call: no a2a store on this device means no peer turn
# can exist, so exit before starting Python.

EVENT="${1:-pretooluse}"
HIPPO_PY="__HIPPO_PY__"
HIPPO_BIN="__HIPPO_BIN__"
A2A_DB="${HIPPOCAMPUS_A2A_DB:-${HIPPOCAMPUS_HOME:-$HOME/.hippocampus}/a2a.db}"

[[ -f "$A2A_DB" ]] || exit 0

if [[ -x "$HIPPO_PY" ]]; then
    "$HIPPO_PY" -m hippocampus.a2a.guard "$EVENT"
else
    "$HIPPO_BIN" a2a hook "$EVENT"
fi
rc=$?
[[ $rc -eq 2 && "$EVENT" != "stop" ]] && exit 2  # deny: the guard already wrote the reason to stderr
# Fail closed: a crashed guard must not let a tool through (Stop never blocks).
if [[ $rc -ne 0 && "$EVENT" != "stop" ]]; then
    echo "A2A guard failed (rc=$rc); blocking tool call while a2a peer turns may be active." >&2
    exit 2
fi
exit 0
