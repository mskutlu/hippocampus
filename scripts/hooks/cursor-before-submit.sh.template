#!/usr/bin/env bash
# Hippocampus beforeSubmitPrompt hook for Cursor.
#
# Stdin: JSON with at least {"prompt": "<user message>", "attachments": [...]}.
# Stdout: JSON `{ "continue": true }`.
#
# IMPORTANT: Cursor's beforeSubmitPrompt output schema is `{continue,
# user_message}` ONLY — unlike Claude Code / Devin it does NOT accept any
# `additional_context` field, so this hook cannot inject memory into the turn.
# We use it purely for its side effects so the working ledger stays current:
#   1. log the user prompt as kind="ask"
#   2. run autoremember on "remember / always / never / add to rules / ..."
# The refreshed ledger then surfaces via the always-on rules file and the
# next sessionStart injection. We always allow the prompt to proceed and
# never block the turn — any internal error still returns {"continue": true}.

set -uo pipefail

CLIENT="${1:-cursor}"
HIPPO_BIN="__HIPPO_BIN__"

INPUT_JSON="$(cat || true)"

PROMPT=""
FULL_PROMPT_FILE=""
if [[ -n "$INPUT_JSON" ]]; then
    # Capped 500-char version goes into the ledger as the ask.
    PROMPT=$(python3 -c '
import json, sys
try:
    data = json.loads(sys.stdin.read() or "{}")
except Exception:
    data = {}
prompt = (data.get("prompt") or "").strip()
if prompt:
    print(prompt[:500])
' <<< "$INPUT_JSON" 2>/dev/null || true)

    # Full prompt (uncapped) goes to autoremember so multi-paragraph
    # "from now on, always do X" rules don't get truncated.
    FULL_PROMPT_FILE=$(mktemp -t hippo-prompt.XXXXXX)
    python3 -c '
import json, sys
try:
    data = json.loads(sys.stdin.read() or "{}")
except Exception:
    data = {}
prompt = (data.get("prompt") or "").strip()
sys.stdout.write(prompt)
' <<< "$INPUT_JSON" > "$FULL_PROMPT_FILE" 2>/dev/null || true
fi

# Side effect: log the ask so the WORKING block reflects this turn.
if [[ -n "$PROMPT" && -x "$HIPPO_BIN" ]]; then
    HIPPOCAMPUS_CLIENT="$CLIENT" "$HIPPO_BIN" progress log ask "$PROMPT" --client "$CLIENT" >/dev/null 2>&1 || true
fi

# Auto-remember on "remember / always / never / add to rules / ..." triggers.
if [[ -n "$FULL_PROMPT_FILE" && -s "$FULL_PROMPT_FILE" && -x "$HIPPO_BIN" ]]; then
    HIPPOCAMPUS_CLIENT="$CLIENT" "$HIPPO_BIN" autoremember --client "$CLIENT" --stdin --quiet < "$FULL_PROMPT_FILE" >/dev/null 2>&1 || true
fi
[[ -n "$FULL_PROMPT_FILE" ]] && rm -f "$FULL_PROMPT_FILE" 2>/dev/null || true

echo '{"continue": true}'
